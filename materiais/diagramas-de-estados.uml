            <XPD:ATTR name="Name" type="string">Parcela</XPD:ATTR>
            <XPD:REF name="Namespace">raEZrFgxSdinOYTxboldGwAA</XPD:REF>
            <XPD:ATTR name="Documentation" type="string">Classe de contexto da máquina de estados. Seus atributos, operações e associações devem ser compatibilizados com o modelo original.</XPD:ATTR>
            <XPD:ATTR name="#Behaviors" type="integer">1</XPD:ATTR>
            <XPD:OBJ name="Behaviors[0]" type="UMLStateMachine" guid="1t8PgyE5S5uEW+FkbpHmRQAA">
              <XPD:ATTR name="Name" type="string">Estados de Parcela</XPD:ATTR>
              <XPD:REF name="Context">Z/OJvW2aRhuusFiquB9sJAAA</XPD:REF>
              <XPD:ATTR name="Documentation" type="string">O diagrama de objetos apresenta Parcela, valor e vencimento. Uma parcela pode ser paga antes ou depois de vencer.
