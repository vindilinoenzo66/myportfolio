    <XPD:OBJ name="DocumentElement" type="UMLProject" guid="oW+oEcoRQW26I1Qy+Nei8QAA">
      <XPD:ATTR name="Title" type="string">Diagramas de Estados - Locadora, Passagens e Veterinária</XPD:ATTR>
      <XPD:ATTR name="Documentation" type="string">Projeto separado com os cinco diagramas propostos. Base: Caderno_Atividades_Objetos_Pacotes.pdf. Não contém os diagramas de classes anteriores. Integração ao projeto original pendente. As hipóteses estão documentadas em cada máquina de estados.</XPD:ATTR>
      <XPD:ATTR name="#OwnedElements" type="integer">1</XPD:ATTR>
